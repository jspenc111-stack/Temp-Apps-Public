rules_version = '2';

// Security rules for the shared fishbowl.
// Paste this whole file into Firebase → Firestore Database → Rules → Publish.
//
// - Only signed-in users (the app signs in anonymously behind the scenes).
// - You can read ONE bowl if you know its code, but never list the bowls.
// - Only rooms/{code} exists, and the code must look like a real room code.
// - A bowl holds at most 15 fish and a feed log of at most 20 entries.
// - Nicknames, fish names and fish types are at most 20 characters.
// - At most 10 hearts and 30 players on the weekly blame board. Like the
//   feed log, hearts are append-only (one new heart at the front).
// - The feed log is append-only: each save may add one new entry at the
//   front, and older entries can't be changed or erased.
// - Bowls can't be deleted.
//
// Firestore stops after 1000 checks per request, so the checks are kept
// small. The rules language has no loops, so fish are checked one position
// at a time (0–14). Thanks to the append-only log, only the newest log entry
// needs checking; older ones were checked when they were added.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRoomCode(code) {
      return code.matches('^[A-HJ-NP-Z2-9]{6}$');
    }

    function shortText(v) {
      return v is string && v.size() <= 20;
    }

    // Kept as cheap as possible: a full bowl has 15 fish to check. Fish saved
    // before types existed have no `type`.
    // The fish's texts in one pattern check (much cheaper than separate
    // checks): name, addedBy and type, each 20 characters or fewer. They're
    // joined with a line break, which none of them can contain. Fish saved
    // before types existed have no `type`. (A fish's `blame` is the nickname
    // of whoever gave the fatal feed; it's checked as the new feed-log entry
    // in the same save, so it isn't checked again here, to stay in budget.)
    function fishOk(f) {
      return (f.name + '\n' + f.addedBy + '\n' + f.get('type', ''))
        .matches('[^\\n]{0,20}\\n[^\\n]{0,20}\\n[^\\n]{0,20}');
    }

    function validFishMap(m) {
      let v = m.values();
      let n = v.size();
      return n <= 15
        && (n < 1 || fishOk(v[0])) && (n < 2 || fishOk(v[1])) && (n < 3 || fishOk(v[2]))
        && (n < 4 || fishOk(v[3])) && (n < 5 || fishOk(v[4])) && (n < 6 || fishOk(v[5]))
        && (n < 7 || fishOk(v[6])) && (n < 8 || fishOk(v[7])) && (n < 9 || fishOk(v[8]))
        && (n < 10 || fishOk(v[9])) && (n < 11 || fishOk(v[10])) && (n < 12 || fishOk(v[11]))
        && (n < 13 || fishOk(v[12])) && (n < 14 || fishOk(v[13])) && (n < 15 || fishOk(v[14]));
    }

    function logEntryOk(e) {
      return e is map
        && e.keys().hasOnly(['by', 'at', 'fishId', 'fishName'])
        && shortText(e.by)
        && e.at is number
        && (e.get('fishName', null) == null || shortText(e.fishName));
    }

    // A list stays the same, or gains exactly one new entry at the front
    // (dropping the oldest once it holds `max`). Used for the feed log (20)
    // and hearts (10).
    function appendOk(next, prev, max) {
      let n = next.size();
      return next is list && n <= max
        && (next == prev
            || ((n == prev.size() + 1 || (n == max && prev.size() == max))
                && logEntryOk(next[0])
                && (n == 1 || next[1:n] == prev[0:n - 1])));
    }

    // Weekly blame board: at most 30 players. (Their nicknames are checked
    // where they enter the bowl: feed-log entries, hearts, and new fish.
    // Checking 30 names again on every save would blow Firestore's budget.)
    function playersOk(p) {
      return p is list && p.size() <= 30;
    }

    function validRoom(d) {
      return d.keys().hasOnly(['createdAt', 'lastFedAt', 'lastFedBy', 'feedLog', 'fish', 'hearts', 'week', 'lastWeek', 'record'])
        && d.keys().hasAll(['createdAt', 'feedLog', 'fish'])
        && d.createdAt is timestamp
        && (d.get('lastFedAt', null) == null || d.lastFedAt is timestamp)
        && (d.get('lastFedBy', null) == null || shortText(d.lastFedBy))
        && d.fish is map
        && validFishMap(d.fish)
        && (d.get('week', null) == null || playersOk(d.week.players))
        && (d.get('record', null) == null || (d.record.name + '\n' + d.record.type).matches('[^\\n]{0,20}\\n[^\\n]{0,20}'));
    }

    match /rooms/{code} {
      // Read one bowl by its code. Listing all bowls is never allowed.
      allow get: if signedIn() && isRoomCode(code);
      allow list: if false;

      // Cheap checks come first so a rule that doesn't apply stops early.
      allow create: if signedIn() && isRoomCode(code)
        && request.resource.data.createdAt == request.time
        && request.resource.data.feedLog == []
        && request.resource.data.get('hearts', []) == []
        && validRoom(request.resource.data);

      allow update: if signedIn() && isRoomCode(code)
        && request.resource.data.createdAt == resource.data.createdAt
        && appendOk(request.resource.data.feedLog, resource.data.feedLog, 20)
        && appendOk(request.resource.data.get('hearts', []), resource.data.get('hearts', []), 10)
        && validRoom(request.resource.data);

      allow delete: if false;
    }

    // Anything not matched above is denied.
  }
}
